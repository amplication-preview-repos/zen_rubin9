datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model DbcCategory {
  categoryName       String?
  createdAt          DateTime        @default(now())
  dbcParsedDataItems DbcParsedData[]
  id                 String          @id @default(cuid())
  updatedAt          DateTime        @updatedAt
}

model DbcParsedData {
  codeName      String?
  codeValue     String?
  createdAt     DateTime     @default(now())
  dbcCategory   DbcCategory? @relation(fields: [dbcCategoryId], references: [id])
  dbcCategoryId String?
  description   String?
  id            String       @id @default(cuid())
  updatedAt     DateTime     @updatedAt
}
