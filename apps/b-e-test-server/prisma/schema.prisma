datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

generator client {
  provider = "prisma-client-js"
}

model DbcCategory {
  categoryName       String?
  createdAt          DateTime        @default(now())
  dbcParsedDataItems DbcParsedData[]
  description        String?
  id                 String          @id @default(cuid())
  typeField          String?
  updatedAt          DateTime        @updatedAt
}

model DbcParsedData {
  codeName        String?
  codeValue       String?
  createdAt       DateTime       @default(now())
  dataType        String?
  dbcCategory     DbcCategory?   @relation(fields: [dbcCategoryId], references: [id])
  dbcCategoryId   String?
  description     String?
  device          Device?        @relation(fields: [deviceId], references: [id])
  deviceId        String?
  fileImportLog   FileImportLog? @relation(fields: [fileImportLogId], references: [id])
  fileImportLogId String?
  id              String         @id @default(cuid())
  rawData         String?
  sourceLine      Int?
  updatedAt       DateTime       @updatedAt
  user            User?          @relation(fields: [userId], references: [id])
  userId          String?
  valid           Boolean?
}

model FileImportLog {
  createdAt          DateTime        @default(now())
  dbcParsedDataItems DbcParsedData[]
  fileName           String?
  id                 String          @id @default(cuid())
  importStatus       String?
  updatedAt          DateTime        @updatedAt
  uploadDate         DateTime?
}

model Device {
  createdAt          DateTime        @default(now())
  dbcParsedDataItems DbcParsedData[]
  description        String?
  deviceName         String?
  id                 String          @id @default(cuid())
  updatedAt          DateTime        @updatedAt
}

model User {
  createdAt          DateTime        @default(now())
  dbcParsedDataItems DbcParsedData[]
  email              String?         @unique
  firstName          String?
  id                 String          @id @default(cuid())
  lastName           String?
  password           String
  roles              Json
  updatedAt          DateTime        @updatedAt
  username           String          @unique
}
